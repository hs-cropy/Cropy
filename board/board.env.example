# 보드 백엔드 설정 — ~/cropy/board.env 로 복사해 쓴다 (systemd cropy-backend가 읽는다)
APP_ENV=production
ALLOW_MOCK_PREDICTIONS=false
# 10클래스(9_기타 포함) 서비스 모델. 체크포인트의 img_size(256)를 백엔드가 읽는다
ML_MODEL_PATH=/home/orangepi/cropy/models/full512_resnet50_other10_v1.pth
ENABLE_PAIR_MODEL=false
DATABASE_URL=sqlite:////home/orangepi/cropy/data/cropcare.db
UPLOAD_DIR=/home/orangepi/cropy/data/uploads
TTS_CACHE_DIR=/home/orangepi/cropy/data/tts_cache
CORS_ORIGINS=http://localhost:3000
STT_ENGINE=http
STT_SERVER_URL=http://127.0.0.1:8200
FUNCTION_SELECTOR_ENGINE=http
FUNCTION_SELECTOR_URL=http://127.0.0.1:8300
# RKLLM 한 번에 약 11초 (프롬프트 1,160토큰 prefill이 대부분)
FUNCTION_SELECTOR_TIMEOUT_SECONDS=60
TTS_ENGINE=http
TTS_SERVER_URL=http://127.0.0.1:8100
