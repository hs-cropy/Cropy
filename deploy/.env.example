# 서버의 저장소 루트에 .env 로 복사해서 쓴다 (커밋하지 않는다)
#   cp deploy/.env.example .env
#
# 서버 고정 IP 뒤에 .sslip.io 를 붙이면 별도 도메인 없이 그 IP로 풀린다.
# 도메인을 구매했다면 그 도메인으로 바꾼다 (DNS A 레코드가 서버 IP를 가리켜야 한다).
SITE_ADDRESS=203.0.113.10.sslip.io

# -f 를 매번 붙이지 않아도 docker compose 가 두 파일을 함께 읽게 한다.
# 구분자 ':' 는 Linux 서버 기준이다 (Windows 는 ';')
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
