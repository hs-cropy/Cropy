{
  "name": "cropy-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-offline.mjs && next dev",
    "build": "node scripts/prepare-offline.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:offline": "node --test tests/offline-core.test.mjs tests/offline-sync.test.mjs tests/offline-ui.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:prototype": "node --test tests/mobile-prototype.test.mjs"
  },
  "dependencies": {
    "next": "^15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "onnxruntime-web": "^1.30.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.115",
    "@iconify/tailwind": "^1.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3",
    "@playwright/test": "^1.64.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss",
      "sharp": "^0.35.5"
    }
  }
}
